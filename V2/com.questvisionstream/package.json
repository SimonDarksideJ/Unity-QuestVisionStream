{
  "name": "@questvisionstream/client",
  "version": "0.1.0",
  "description": "Reusable, host-agnostic WebRTC streaming client for QuestVisionStream, built as RealityCollective Service Framework services. Speaks the QuestVisionStreamServer protocol and exposes a framework-agnostic detection rendering seam.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "rm -rf dist"
  },
  "keywords": ["webxr", "webrtc", "quest", "object-detection", "yolo", "iwsdk", "service-framework"],
  "license": "MIT",
  "dependencies": {
    "@realitycollective/service-framework-ts": "file:../service-framework"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
