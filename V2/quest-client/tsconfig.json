{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["three", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@realitycollective/service-framework-ts": ["../service-framework/src/index.ts"],
      "@questvisionstream/client": ["../com.questvisionstream/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
